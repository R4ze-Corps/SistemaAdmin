# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=refugio_gestao

# Criado automaticamente ao conectar um Vercel Blob ao projeto
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Conta administradora: use seu nome de login e uma chave aleatória com pelo menos 32 caracteres.
# A chave é informada apenas ao criar a conta administradora; nunca use NEXT_PUBLIC_.
ADMIN_LOGIN=administrador
ADMIN_SETUP_KEY=
