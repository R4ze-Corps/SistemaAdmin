# MongoDB Atlas
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=refugio_gestao

# Criado automaticamente ao conectar um Vercel Blob ao projeto
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Configure também no projeto da Vercel para autenticar o backup agendado.
# Gere um segredo aleatório de pelo menos 16 caracteres.
CRON_SECRET=gere-um-segredo-aleatorio-com-16-caracteres-ou-mais

# O primeiro cadastro cria o administrador. Não há credenciais de login no .env.
